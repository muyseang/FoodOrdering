@page
@model FoodOrderingSystem.Pages.Admin.FoodItems.CreateModel

@{
    ViewData["Title"] = "Create New Food Item";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<div class="container-fluid py-4">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h1 class="h3 mb-1 text-gray-800">
                <i class="fas fa-plus-circle text-primary me-2"></i>
                Create New Food Item
            </h1>
            <p class="text-muted mb-0">Add a new item to your menu</p>
        </div>
        <a asp-page="Index" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i>
            Back to List
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-utensils me-2"></i>
                        Food Item Information
                    </h5>
                </div>
                <div class="card-body">
                    <form method="post">
                        <div asp-validation-summary="All" class="alert alert-danger d-none" role="alert"></div>
                        
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="FoodItem.Name" class="form-label fw-semibold">
                                    <i class="fas fa-tag text-primary me-1"></i>
                                    Item Name
                                </label>
                                <input asp-for="FoodItem.Name" class="form-control" placeholder="Enter food item name" />
                                <span asp-validation-for="FoodItem.Name" class="text-danger small"></span>
                            </div>
                            
                            <div class="col-md-6 mb-3">
                                <label asp-for="FoodItem.Price" class="form-label fw-semibold">
                                    <i class="fas fa-dollar-sign text-success me-1"></i>
                                    Price
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input asp-for="FoodItem.Price" class="form-control" placeholder="0.00" step="0.01" />
                                </div>
                                <span asp-validation-for="FoodItem.Price" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="FoodItem.Category" class="form-label fw-semibold">
                                    <i class="fas fa-list text-info me-1"></i>
                                    Category
                                </label>
                                <select asp-for="FoodItem.Category" class="form-select">
                                    <option value="">Select Category</option>
                                    <option value="A La Carte">🍽️ A La Carte</option>
                                    <option value="Snack">� Snack</option>
                                    <option value="Fried Chicken">🍗 Fried Chicken</option>
                                    <option value="Rice and Salad">🥗 Rice and Salad</option>
                                    <option value="Coffee">☕ Coffee</option>
                                </select>
                                <span asp-validation-for="FoodItem.Category" class="text-danger small"></span>
                            </div>
                            
                            <div class="col-md-6 mb-3">
                                <label asp-for="FoodItem.ImageUrl" class="form-label fw-semibold">
                                    <i class="fas fa-image text-warning me-1"></i>
                                    Image URL
                                </label>
                                <input asp-for="FoodItem.ImageUrl" class="form-control" placeholder="https://example.com/image.jpg" id="imageUrlInput" />
                                <span asp-validation-for="FoodItem.ImageUrl" class="text-danger small"></span>
                                <div class="form-text">Enter a valid image URL for the food item</div>
                                
                                <div class="mt-3" id="imagePreviewContainer" style="display: none;">
                                    <label class="form-label fw-semibold">
                                        <i class="fas fa-eye text-info me-1"></i>
                                        Preview
                                    </label>
                                    <div class="border rounded p-2 bg-light">
                                        <img id="imagePreview" src="" alt="Image Preview" class="img-fluid rounded" style="max-height: 200px; max-width: 100%; object-fit: cover;" />
                                        <div class="mt-2">
                                            <small class="text-muted" id="imageStatus">Loading image...</small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="FoodItem.Description" class="form-label fw-semibold">
                                <i class="fas fa-align-left text-secondary me-1"></i>
                                Description
                            </label>
                            <textarea asp-for="FoodItem.Description" class="form-control" rows="4" 
                                     placeholder="Enter a detailed description of the food item..."></textarea>
                            <span asp-validation-for="FoodItem.Description" class="text-danger small"></span>
                            <div class="form-text">Provide an appetizing description that will entice customers</div>
                        </div>

                        <div class="d-flex gap-2 pt-3 border-top">
                            <button type="submit" class="btn btn-primary px-4">
                                <i class="fas fa-save me-1"></i>
                                Create Item
                            </button>
                            <a asp-page="Index" class="btn btn-outline-secondary px-4">
                                <i class="fas fa-times me-1"></i>
                                Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const imageUrlInput = document.getElementById('imageUrlInput');
    const imagePreview = document.getElementById('imagePreview');
    const imagePreviewContainer = document.getElementById('imagePreviewContainer');
    const imageStatus = document.getElementById('imageStatus');
    
    let timeoutId;
    
    if (imageUrlInput) {
        
        imageUrlInput.addEventListener('input', function() {
            clearTimeout(timeoutId);
            const url = this.value.trim();
            
            if (!url) {
                hideImagePreview();
                return;
            }
            
            timeoutId = setTimeout(() => {
                loadImagePreview(url);
            }, 500); // Wait 500ms after user stops typing
        });
        
        
        imageUrlInput.addEventListener('blur', function() {
            if (this.value.trim()) {
                loadImagePreview(this.value.trim());
            }
        });
    }
    
    function loadImagePreview(url) {
        
        if (!isValidUrl(url)) {
            showImageError('Please enter a valid URL');
            return;
        }
        
        
        showImageLoading();
        
        
        const testImg = new Image();
        
        testImg.onload = function() {
            imagePreview.src = url;
            showImageSuccess('Image loaded successfully');
        };
        
        testImg.onerror = function() {
            showImageError('Failed to load image. Please check the URL or try a different image.');
        };
        
        
        setTimeout(() => {
            if (!testImg.complete) {
                showImageError('Image is taking too long to load. Please try a different URL.');
            }
        }, 10000); // 10 second timeout
        
        testImg.src = url;
    }
    
    function isValidUrl(string) {
        try {
            new URL(string);
            return true;
        } catch (_) {
            return false;
        }
    }
    
    function showImageLoading() {
        imagePreviewContainer.style.display = 'block';
        imagePreview.src = 'data:image/svg+xml;base64,';
        imageStatus.textContent = 'Loading image...';
        imageStatus.className = 'text-info';
    }
    
    function showImageSuccess(message) {
        imageStatus.textContent = message;
        imageStatus.className = 'text-success';
    }
    
    function showImageError(message) {
        imagePreviewContainer.style.display = 'block';
        imagePreview.src = 'data:image/svg+xml;base64,';
        imageStatus.textContent = message;
        imageStatus.className = 'text-danger';
    }
    
    function hideImagePreview() {
        imagePreviewContainer.style.display = 'none';
    }
    
    
    const form = document.querySelector('form');
    form.addEventListener('submit', function(e) {
        const validationSummary = document.querySelector('[asp-validation-summary]');
        const errors = document.querySelectorAll('.text-danger:not(:empty)');
        
        if (errors.length > 0) {
            validationSummary.classList.remove('d-none');
            validationSummary.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
    });
});
</script>

<style>
.card {
    border: none;
    border-radius: 12px;
}

.card-header {
    border-radius: 12px 12px 0 0 !important;
    border: none;
    padding: 1.25rem 1.5rem;
}

.form-label {
    color: #374151;
    margin-bottom: 0.5rem;
}

.form-control, .form-select {
    border: 1.5px solid #e5e7eb;
    border-radius: 8px;
    padding: 0.75rem 1rem;
    transition: all 0.2s ease;
}

.form-control:focus, .form-select:focus {
    border-color: #3b82f6;
    box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
}

.input-group-text {
    background-color: #f8fafc;
    border: 1.5px solid #e5e7eb;
    border-right: none;
    color: #6b7280;
    font-weight: 500;
}

.btn {
    border-radius: 8px;
    font-weight: 500;
    padding: 0.75rem 1.5rem;
    transition: all 0.2s ease;
}

.btn-primary {
    background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%);
    border: none;
    box-shadow: 0 2px 4px rgba(59, 130, 246, 0.2);
}

.btn-primary:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 8px rgba(59, 130, 246, 0.3);
}

.btn-outline-secondary {
    border: 1.5px solid #e5e7eb;
    color: #6b7280;
}

.btn-outline-secondary:hover {
    background-color: #f8fafc;
    border-color: #d1d5db;
    color: #374151;
}

.text-danger {
    font-size: 0.875rem;
    margin-top: 0.25rem;
}

.form-text {
    font-size: 0.875rem;
    color: #6b7280;
    margin-top: 0.25rem;
}

.alert-danger {
    border-radius: 8px;
    border: none;
    background-color: #fef2f2;
    color: #dc2626;
    border-left: 4px solid #dc2626;
}

 
.form-control, .form-select, .btn {
    animation: slideInUp 0.3s ease;
}

@@keyframes slideInUp {
    from {
        opacity: 0;
        transform: translateY(10px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

 
#imagePreviewContainer {
    animation: fadeIn 0.3s ease;
}

#imagePreview {
    border: 2px solid #e5e7eb;
    transition: all 0.3s ease;
}

#imagePreview:hover {
    transform: scale(1.02);
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
}

@@keyframes fadeIn {
    from {
        opacity: 0;
        transform: translateY(-10px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.bg-light {
    background-color: #f8fafc !important;
}
</style>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
